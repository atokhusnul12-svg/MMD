# ==============================================================================
# ONESIGNAL CONFIGURATION - WAKA III MMD
# ==============================================================================
# 1. NEXT_PUBLIC_ONESIGNAL_APP_ID:
#    Dapatkan dari OneSignal Dashboard -> App Settings -> Keys & IDs -> OneSignal App ID
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# 2. ONESIGNAL_REST_API_KEY:
#    Dapatkan dari OneSignal Dashboard -> App Settings -> Keys & IDs -> REST API Key
#    (Digunakan oleh server API Next.js untuk mengirim push notification broadcast)
ONESIGNAL_REST_API_KEY=
