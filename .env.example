# ==============================================================================
# ONESIGNAL CONFIGURATION - WAKA III MMD
# ==============================================================================
# 1. NEXT_PUBLIC_ONESIGNAL_APP_ID:
#    Dapatkan dari OneSignal Dashboard -> App Settings -> Keys & IDs -> OneSignal App ID
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# 2. ONESIGNAL_REST_API_KEY:
#    Dapatkan dari OneSignal Dashboard -> App Settings -> Keys & IDs -> REST API Key
#    (Digunakan oleh server API Next.js untuk mengirim push notification broadcast)
ONESIGNAL_REST_API_KEY=

# ==============================================================================
# GOOGLE SHEETS WRITE-BACK SYNC (GOOGLE APPS SCRIPT WEB APP)
# ==============================================================================
# 3. GOOGLE_SHEETS_SCRIPT_URL:
#    URL Deployment Web App dari Google Apps Script (berakhiran /exec).
#    Dapatkan setelah Deploy Apps Script di Spreadsheet: Extensions -> Apps Script -> Deploy -> New deployment
GOOGLE_SHEETS_SCRIPT_URL=

# 4. SHEETS_API_SECRET_TOKEN:
#    Token acak minimal 32-byte entropi yang disetel sama persis antara
#    Script Properties Google Apps Script dan server Next.js.
#    Hasilkan token baru secara lokal (misal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
#    JANGAN pernah membagikan nilai token ini ke publik atau menyimpannya di git!
SHEETS_API_SECRET_TOKEN=
