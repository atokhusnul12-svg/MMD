# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — WAKA III MMD
# ==============================================================================

# 1. GOOGLE APPS SCRIPT WEB APP DEPLOYMENT (Tulis ke Google Sheets)
#    Dapatkan setelah Deploy Apps Script di Spreadsheet: Extensions -> Apps Script -> Deploy -> New deployment
GOOGLE_SHEETS_SCRIPT_URL=

# 2. SHEETS_API_SECRET_TOKEN:
#    Token acak minimal 32 karakter yang disetel SAMA PERSIS antara:
#    (a) Script Properties di Google Apps Script (Project Settings -> Script Properties)
#    (b) Environment Variable di Vercel Dashboard / .env.local
SHEETS_API_SECRET_TOKEN=

# 3. CSV PUBLIK GOOGLE SHEETS
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTsQOTraj9_EG-AI7w9NZ67QoYCitp4oeFhL4nasln_tDGNQM54owTeLVRIKebdMwH4v6CG5OautZry/pub?output=csv
NEXT_PUBLIC_GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTsQOTraj9_EG-AI7w9NZ67QoYCitp4oeFhL4nasln_tDGNQM54owTeLVRIKebdMwH4v6CG5OautZry/pub?output=csv

# 4. AUTENTIKASI PENGURUS (SERVER-SIDE ONLY - TIDAK BOLEH DIAWALI NEXT_PUBLIC_)
ADMIN_USERNAME=MMD
ADMIN_PASSWORD=
SESSION_SECRET=

# 5. WEB PUSH NOTIFICATION (VAPID RFC 8292)
#    Hasilkan key baru via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:waka3mmd@darussalamah.sch.id
